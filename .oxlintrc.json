{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  }
}